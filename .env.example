# =============================================================================
# Environment Variables Template (.env.example)
# -----------------------------------------------------------------------------
# Copy this file to `.env` (which is git-ignored) and adjust values as needed.
# The application loads these values via `dotenv` in `src/config/index.js`.
# Each variable below has a safe default that preserves the original
# `127.0.0.1:3000` bind behavior of the legacy `server.js` implementation.
# =============================================================================

# Application environment
NODE_ENV=development

# HTTP server bind address (default preserves original loopback behavior)
HOST=127.0.0.1

# HTTP server port
PORT=3000

# Logging level for winston (e.g., error, warn, info, http, debug)
LOG_LEVEL=info
